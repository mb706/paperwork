# Build outputs and caches (the root .gitignore covers node_modules/, dist/ and the Playwright reports too).
node_modules/
dist/
target/
.cache/
public/data/
test-results/
playwright-report/
# The asset build's outputs (10 §9.6: only sources are committed; npm run assets rebuilds them from the cache)
public/atlases/
public/sheets/
public/fonts/
# The dev server's endpoints (10 §3.5): bug reports and screenshots from the user's session (bench/user-results/
# is kept: bench.html's results are small and the host factor's evidence)
bench/reports/
bench/shots/
