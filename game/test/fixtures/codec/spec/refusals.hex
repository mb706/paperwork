@type removed_proto                       # name is not UTF-8
1c 00 00 00                                            // removed_proto: L = 28
01 00 01 00 00 00  00                                  // id 1 kind, len 1: 0
02 00 05 00 00 00  03 00  61 ff 62                     // id 2 name, len 5: str: u16 length 3, "a" 0xFF "b" (0xFF never occurs in UTF-8)
03 00 04 00 00 00  01 00 00 00                         // id 3 count, len 4: 1
@error bad_utf8

@type meta_contents                       # meta[0]: 256 bytes, item_max 255
16 01 00 00                                            // meta_contents: L = 278
01 00 06 01 00 00                                      // id 1 meta, len 262:
  01 00 00 00                                          //   list: u32 count 1
