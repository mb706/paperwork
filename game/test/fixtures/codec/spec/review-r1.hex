# ---- finding 5: a log's closures pass the preflight's framing rules before their actions are walked ----------
# The review's closure: a batch of count 0, then a framed clear_cursor (41).
@closure_log
5057434c020001000000000001000000
abababababababababababababababab
abababababababababababababababab
cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd
cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd
8877665544332211010000001c000000
00000000000000000000000000000000
00000000010000001400000001000000
01000000010000000000000029000000
@error bad_framing ClosureRecord.closure @124

# A clear_cursor whose payload (len 5) runs past the closure.
@closure_log
5057434c020001000000000001000000
abababababababababababababababab
abababababababababababababababab
cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd
cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd
8877665544332211010000001e000000
00000000000000000000000000000000
00000000010000001600000001000000
01000000010000000100000029000500
0000
@error bad_framing ClosureRecord.closure @140

# ---- finding 7: lenient reads give the declared defaults, bit for bit, in both languages ----------------------
# map_settings with no fields at all: every field at its default.
@lenient map_settings
00 00 00 00
@dump
width=0
height=0
starting_area=f64:3ff0000000000000
resources.len=0
water_scale=f64:3ff0000000000000
water_coverage=f64:3ff0000000000000
trees_frequency=f64:3ff0000000000000
trees_size=f64:3ff0000000000000
cliffs_frequency=f64:3ff0000000000000
cliffs_continuity=f64:3ff0000000000000
towns_frequency=f64:3ff0000000000000
towns_size=f64:3ff0000000000000
archives_size=f64:3ff0000000000000
archives_richness=f64:3ff0000000000000
exchanges_richness=f64:3ff0000000000000
