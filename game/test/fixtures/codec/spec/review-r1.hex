# ---- finding 4: counts are checked before anything is allocated ----------------------------------------------
# A table header claiming 2^32 − 1 rows and no columns: over max_rows (4,194,304).
@table container
ff ff ff ff  00 00  00 00
@error too_long container @0

# 16 rows and no columns: a table with rows must carry its live column.
@table entity_table
10 00 00 00  00 00  00 00
@error missing_field entity_table.serial @0

