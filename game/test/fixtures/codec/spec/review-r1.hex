# Regression fixtures for codex's review C1b-r1: each case fails on the code before its fix in at least one
# language. Layouts as in game/schema/README.md; the bytes were assembled by a throwaway script from the
# README's rules and checked by hand against the comments.

# ---- finding 1: a leading U+FEFF is a character (TypeScript's TextDecoder used to strip it) ------------------
# console_command (122) with text "\uFEFFx": u16 len 4, EF BB BF 78. The dump line holds U+FEFF before the x.
@action
7a 00 06 00  04 00 ef bb bf 78
@dump
type=console_command
text="﻿x"

# The same with a BOM-only text.
@action
7a 00 05 00  03 00 ef bb bf
@dump
type=console_command
text="﻿"

# A record's string: removed_proto {kind 3 (entity), name "\uFEFFa", count 5}.
@type removed_proto
1d 00 00 00                       // record length 29
01 00 01 00 00 00 03              // #1 kind, len 1: entity
02 00 06 00 00 00 04 00 ef bb bf 61   // #2 name, len 6: str "\uFEFFa"
03 00 04 00 00 00 05 00 00 00     // #3 count, len 4: 5
@dump
kind=3
name="﻿a"
count=5

# A message's string: InspectField {section 0, type 1 (u8), name "\uFEFFn", value empty}.
@type InspectField
00 00 00 00  01  00  04 00 ef bb bf 6e  00 00
@dump
section=0
type=1
name="﻿n"
value=hex:

# ---- finding 2: free pool rows are canonical in both languages ------------------------------------------------
# container: rows 2, columns entity (u32 serial) at 40 and inv (u32) at 48. Row 0 is live (serial 5, block 0);
# row 1 is free, so inv must be its default 0xFFFFFFFF.
@table container
020000000200000006656e7469747903
00280000000800000003696e76030030
00000008000000000500000000000000
00000000ffffffff
@ok rows=2

# The same with the free row's inv at 0: refused at that value (48 + 4).
@table container
020000000200000006656e7469747903
00280000000800000003696e76030030
00000008000000000500000000000000
0000000000000000
@error not_canonical container.inv @52

