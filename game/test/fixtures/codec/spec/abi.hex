@type SubscribeInput                      # u16 count, SubRequest[count]: variable-size items (one with a tail)
02 00                                     // count 2
05 00 00 00  03 00  00 00  4d 00 00 00    // subs[0]: sub_id 5, kind 3 (INVENTORY), flags 0, target 77
02 00 00 00  00 00 00 00  00 00 00 00  00 00 00 00   //   p0 2 (chest), p1 0, p2 0, p3 0 (no tail)
06 00 00 00  07 00  01 00  00 00 00 00    // subs[1]: sub_id 6, kind 7 (STATS), flags 1 (tail), target 0
00 00 00 00  00 00 00 00  00 00 00 00  00 00 00 00   //   p0 0, p1 0, p2 0, p3 0
04 00  28 00 00 01                        //   tail: 4 bytes (StatKey 0x01000028)
@dump
