@type sim_meta                            # u64, list<player_meta> ascending by index
8a 00 00 00                                            // sim_meta: L = 138
01 00 04 00 00 00  58 02 00 00                         // id 1 tick, len 4: 600
02 00 04 00 00 00  ee ff c0 00                         // id 2 seed, len 4: 12648430
03 00 04 00 00 00  03 00 00 00                         // id 3 last_system_seq, len 4: 3
04 00 04 00 00 00  01 00 00 00                         // id 4 worldgen_version, len 4: 1
05 00 08 00 00 00  ef cd ab 89 67 45 23 01             // id 5 r, len 8: 81985529216486895
06 00 4e 00 00 00                                      // id 6 players, len 78:
  02 00 00 00                                          //   list: u32 count 2
    21 00 00 00                                        //     [0] player_meta: L = 33
    01 00 02 00 00 00  00 00                           //     [0] id 1 index, len 2: 0
    02 00 01 00 00 00  01                              //     [0] id 2 online, len 1: true
    03 00 04 00 00 00  2a 00 00 00                     //     [0] id 3 last_seq, len 4: 42
    04 00 02 00 00 00  01 00                           //     [0] id 4 input_gen, len 2: 1
    21 00 00 00                                        //     [1] player_meta: L = 33
    01 00 02 00 00 00  05 00                           //     [1] id 1 index, len 2: 5
    02 00 01 00 00 00  00                              //     [1] id 2 online, len 1: false
    03 00 04 00 00 00  07 00 00 00                     //     [1] id 3 last_seq, len 4: 7
    04 00 02 00 00 00  ff ff                           //     [1] id 4 input_gen, len 2: 65535
