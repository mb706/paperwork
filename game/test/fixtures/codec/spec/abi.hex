@type load_report                         # list<removed_proto>: str in a record (u16 length), non-ASCII
6c 00 00 00                                            // load_report: L = 108
01 00 01 00 00 00  01                                  // id 1 new_lineage, len 1: true
02 00 08 00 00 00  10 32 54 76 98 ba dc fe             // id 2 r, len 8: 18364758544493064720
03 00 51 00 00 00                                      // id 3 removed, len 81:
  02 00 00 00                                          //   list: u32 count 2
    21 00 00 00                                        //     [0] removed_proto: L = 33
    01 00 01 00 00 00  00                              //     [0] id 1 kind, len 1: 0
    02 00 0a 00 00 00  08 00  6f 6c 64 2d 67 65 61 72  //     [0] id 2 name, len 10: str: u16 length 8, "old-gear"
    03 00 04 00 00 00  0c 00 00 00                     //     [0] id 3 count, len 4: 12
    24 00 00 00                                        //     [1] removed_proto: L = 36
    01 00 01 00 00 00  03                              //     [1] id 1 kind, len 1: 3
    02 00 0d 00 00 00  0b 00  43 61 66 c3 a9 2d 63 68 65 73 74 //     [1] id 2 name, len 13: str: u16 length 11, "Café-chest"
    03 00 04 00 00 00  01 00 00 00                     //     [1] id 3 count, len 4: 1
@dump
new_lineage=true
r=18364758544493064720
removed.len=2
removed[0].kind=0
removed[0].name="old-gear"
removed[0].count=12
removed[1].kind=3
removed[1].name="Café-chest"
removed[1].count=1

