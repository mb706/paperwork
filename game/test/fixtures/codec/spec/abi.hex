@type QueryStepOutput                     # u32 count, QueryResult[count], each padded to 4
02 00 00 00                               // count 2
09 00 00 00  01  01  00 00                // results[0]: id 9, ok true, flags 1 (truncated), reserved
58 02 00 00  58 02 00 00  14 00 00 00     //   first_tick 600, last_tick 600, len 20
58 02 00 00  01 00 00 00 00 00 00 00  02 00 00 00 00 00 00 00   //   body: a DigestResult (tick 600, d 1, r 2); 20 + 20 = 40 bytes, no padding
0a 00 00 00  00  00  00 00                // results[1]: id 10, ok false, flags 0, reserved
59 02 00 00  5a 02 00 00  02 00 00 00     //   first_tick 601, last_tick 602, len 2
04 00                                     //   body: UiInvalidReason 4 (not_found)
00 00                                     //   padding: 20 + 2 = 22 → 24
@dump
