# The WebAssembly ABI's records and messages (10 §15.8, §15.9; abi.yaml).
#
# Hand-written from the README and abi.yaml only (the record hex was laid out with a throwaway helper from
# field ids and types read off abi.yaml; every byte is annotated). Records (`records:`) use the field-id
# encoding: u32 L, then L bytes of (u16 id, u32 len, value) triples in ascending id; a nested record's value
# is its whole encoding; in a record a list is a u32 count, then its items (a record item is a whole
# record), a str is a u16 length and UTF-8, and `bool`, enums and ids take their base width. @type decodes a
# record strictly, so every field is present. Records dump every field.
#
# Covers: new_world (nested map_settings / world_settings / game_settings, a list of two resource_settings
# records), sim_meta (u64, list<player_meta>), load_report (list<removed_proto>, a str in a record with
# non-ASCII; and two entries of the same kind ascending by name), chunk_data ([TileId; 1024], lists of
# structs ordered by key with a negative i32 key, an empty list), and the ABI messages BlobPut (u8[..]),
# PendingChunks, SubscribeInput (an array of variable-size messages), QueryStepOutput (padded
# QueryResults), PoolDir (T[..] of structs), TickDigest (four hidden counts, a 22-byte packed struct),
# LoadInput (SectionFrame and RemapTable arrays; a frame at offset 4 pads from its own start),
# GenInitInput (a message that ends in a record).

@type new_world                           # nested records, a list of records, every field (strict read)
1e 02 00 00                                            // new_world: L = 542
01 00 04 00 00 00  ee ff c0 00                         // id 1 seed, len 4: 12648430
02 00 36 01 00 00                                      // id 2 map, len 310:
  32 01 00 00                                          //   map_settings: L = 306
  01 00 04 00 00 00  00 01 00 00                       //   id 1 width, len 4: 256
  02 00 04 00 00 00  c0 00 00 00                       //   id 2 height, len 4: 192
  03 00 08 00 00 00  00 00 00 00 00 00 f4 3f           //   id 3 starting_area, len 8: 1.25
  04 00 70 00 00 00                                    //   id 4 resources, len 112:
    02 00 00 00                                        //     list: u32 count 2
      32 00 00 00                                      //       [0] resource_settings: L = 50
      01 00 02 00 00 00  00 00                         //       [0] id 1 resource, len 2: 0
      02 00 08 00 00 00  00 00 00 00 00 00 f0 3f       //       [0] id 2 frequency, len 8: 1.0
      03 00 08 00 00 00  00 00 00 00 00 00 e0 3f       //       [0] id 3 size, len 8: 0.5
      04 00 08 00 00 00  00 00 00 00 00 00 00 40       //       [0] id 4 richness, len 8: 2.0
      32 00 00 00                                      //       [1] resource_settings: L = 50
      01 00 02 00 00 00  03 00                         //       [1] id 1 resource, len 2: 3
      02 00 08 00 00 00  00 00 00 00 00 00 e8 3f       //       [1] id 2 frequency, len 8: 0.75
      03 00 08 00 00 00  00 00 00 00 00 00 f0 3f       //       [1] id 3 size, len 8: 1.0
      04 00 08 00 00 00  00 00 00 00 00 00 f0 3f       //       [1] id 4 richness, len 8: 1.0
  05 00 08 00 00 00  00 00 00 00 00 00 f0 3f           //   id 5 water_scale, len 8: 1.0
  06 00 08 00 00 00  00 00 00 00 00 00 e0 3f           //   id 6 water_coverage, len 8: 0.5
  07 00 08 00 00 00  00 00 00 00 00 00 f0 3f           //   id 7 trees_frequency, len 8: 1.0
  08 00 08 00 00 00  00 00 00 00 00 00 f0 3f           //   id 8 trees_size, len 8: 1.0
  09 00 08 00 00 00  00 00 00 00 00 00 00 00           //   id 9 cliffs_frequency, len 8: 0.0
  0a 00 08 00 00 00  00 00 00 00 00 00 f0 3f           //   id 10 cliffs_continuity, len 8: 1.0
  0b 00 08 00 00 00  00 00 00 00 00 00 00 40           //   id 11 towns_frequency, len 8: 2.0
  0c 00 08 00 00 00  00 00 00 00 00 00 f0 3f           //   id 12 towns_size, len 8: 1.0
  0d 00 08 00 00 00  00 00 00 00 00 00 f0 3f           //   id 13 archives_size, len 8: 1.0
  0e 00 08 00 00 00  00 00 00 00 00 00 08 40           //   id 14 archives_richness, len 8: 3.0
  0f 00 08 00 00 00  00 00 00 00 00 00 f0 3f           //   id 15 exchanges_richness, len 8: 1.0
03 00 c1 00 00 00                                      // id 3 world, len 193:
  bd 00 00 00                                          //   world_settings: L = 189
  01 00 01 00 00 00  01                                //   id 1 heat, len 1: true
  02 00 01 00 00 00  00                                //   id 2 staffing, len 1: false
  03 00 01 00 00 00  02                                //   id 3 runaways, len 1: 2 (wild)
  04 00 08 00 00 00  a3 f4 07 83 28 5a fb 3f           //   id 4 returns_to_research, len 8: 1.7095112913514547
  05 00 01 00 00 00  01                                //   id 5 race_mode, len 1: 1 (race)
  06 00 01 00 00 00  01                                //   id 6 scooped, len 1: true
  07 00 01 00 00 00  01                                //   id 7 hollow_work, len 1: true
  08 00 01 00 00 00  00                                //   id 8 climate_compass, len 1: false
  09 00 08 00 00 00  00 00 00 00 00 00 00 40           //   id 9 tech_price_multiplier, len 8: 2.0
  0a 00 08 00 00 00  00 00 00 00 00 00 00 00           //   id 10 field_pace, len 8: 0.0
  0b 00 08 00 00 00  00 00 00 00 00 00 f0 3f           //   id 11 leak_rate_multiplier, len 8: 1.0
  0c 00 08 00 00 00  00 00 00 00 00 00 f0 3f           //   id 12 staffing_radius, len 8: 1.0
  0d 00 08 00 00 00  00 00 00 00 00 00 d0 3f           //   id 13 staffing_supply, len 8: 0.25
  0e 00 08 00 00 00  00 00 00 00 00 00 f0 3f           //   id 14 heat_diffusion_share, len 8: 1.0
  0f 00 08 00 00 00  00 00 00 00 00 00 f0 3f           //   id 15 heat_min_diffuse, len 8: 1.0
  10 00 08 00 00 00  00 00 00 00 00 00 f0 3f           //   id 16 heat_cooling_multiplier, len 8: 1.0
  11 00 08 00 00 00  00 00 00 00 00 00 f0 3f           //   id 17 heat_tree_damage_threshold, len 8: 1.0
04 00 0b 00 00 00                                      // id 4 game, len 11:
  07 00 00 00                                          //   game_settings: L = 7
  01 00 01 00 00 00  01                                //   id 1 trimmed_collision, len 1: true
