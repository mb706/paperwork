{
  "name": "paperwork",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Paperwork: a Factorio-like about AI research. Information is physical.",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "sh scripts/wasm-release.sh && vite build",
    "preview": "vite preview",
    "data": "node scripts/data-stage.ts",
    "assets": "node scripts/build-assets.ts",
    "gen": "node scripts/schema-gen.ts",
    "check": "node scripts/ci.ts check",
    "test": "node scripts/ci.ts test",
    "test:slow": "node scripts/ci.ts slow",
    "e2e": "playwright test",
    "ci": "node scripts/ci.ts ci",
    "ci:fast": "node scripts/ci.ts fast",
    "bench:ab": "node bench/ab.ts",
    "check-arch": "node scripts/check-arch.ts",
    "format": "biome check --write ."
  },
  "dependencies": {
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.1",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "maxrects-packer": "2.7.4",
    "oxc-parser": "0.153.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "simplex-noise": "4.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.3",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
